# Copy to ".env" and fill in. NEVER commit ".env".

# Same Atlas cluster as your portfolio, but a DIFFERENT database name (/helpdesk)
MONGODB_URI=mongodb://<db_user>:<db_password>@<hosts>/helpdesk?ssl=true&authSource=admin

# 5001 so it does not clash with the portfolio API (5000)
PORT=5001

# Random string, 32+ chars. Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_characters

# Allowed frontend origins, comma-separated, no trailing slash
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Optional
# JWT_EXPIRES_IN=8h
# NODE_ENV=production
